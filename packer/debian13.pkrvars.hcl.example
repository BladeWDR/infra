# Copy this file to debian13.auto.pkrvars.hcl and fill in the secrets.
# It is gitignored (see .gitignore) — do NOT commit your real values. The
# .auto.pkrvars.hcl name means Packer auto-loads it on directory invocation:
#   cd packer && packer build .
# (Pointing Packer at the template *file* instead needs
#  -var-file=debian13.auto.pkrvars.hcl.)
#
# Alternatively, export these as environment variables instead of a var file:
#   PROXMOX_URL, PROXMOX_USERNAME, PROXMOX_TOKEN, PACKER_BUILD_PASSWORD

# ---- Proxmox API (least-privilege token; see README.md for creation) ----
proxmox_url      = "https://pve.example.com:8006/api2/json"
proxmox_username = "packer@pve!token"   # <user>@<realm>!<token-id>
proxmox_token    = "PASTE_THE_TOKEN_SECRET_HERE"

# ---- Build-time credentials ----
# Temporary password for the build user; injected into the preseed and locked
# after provisioning. Required — the build will not SSH in without it.
build_user     = "ansible"
build_password = "PASTE_A_STRONG_TEMP_BUILD_PASSWORD"

# ---- Verify these against pve04's actual layout (defaults assume a stock PVE) ----
# proxmox_node            = "pve04"
# network_bridge          = "vmbr0"
# disk_storage            = "local-lvm"
# cloud_init_storage_pool = "local"
# efi_storage_pool        = "local"
