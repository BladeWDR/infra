# Secrets live in per-scope *.pkrvars.hcl files at the packer/ root (NOT
# auto-loaded). They are gitignored — do NOT commit your real values — and are
# supplied to a build explicitly with -var-file, so each build pulls exactly the
# secret for its target. Per-node LAYOUT (url/node/storage/bridge/iso) lives in
# the committed vars/pveXX.pkrvars.hcl files and is layered on with -var-file too.
#
#   cluster build:  packer build -var-file=cluster.pkrvars.hcl   -var-file=vars/pve01.pkrvars.hcl .
#   pve04 build:    packer build -var-file=pve04.pkrvars.hcl     -var-file=vars/pve04.pkrvars.hcl .
#
# Copy this to a gitignored per-scope file and fill in the secret. Use the file
# that matches the target you are building (see README.md):
#   - cluster.pkrvars.hcl  -> the pve01-03 cluster token + build password
#   - pve04.pkrvars.hcl    -> pve04's token + build password
#
# (Alternatively, export PROXMOX_USERNAME, PROXMOX_TOKEN, PACKER_BUILD_PASSWORD as
#  environment variables instead of a file.)

# ---- Proxmox API (least-privilege token; see README.md for creation) ----
proxmox_username = "packer@pve!token"   # <user>@<realm>!<token-id>
proxmox_token    = "PASTE_THE_TOKEN_SECRET_HERE"

# ---- Build-time credentials ----
# Temporary password for the build user; injected into the preseed and locked
# after provisioning. Required — the build will not SSH in without it.
build_user     = "ansible"
build_password = "PASTE_A_STRONG_TEMP_BUILD_PASSWORD"
