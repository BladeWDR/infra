---

networks:
  grafana_net:
    driver: bridge
    name: grafana_net
  traefik:
    driver: bridge
    name: traefik

services:
  traefik:
    image: traefik:v3.7.14@sha256:575fa15b135078fe5e50aa847987d96dbddd7b093c172429618404df73f3fa7c
    container_name: ${TRAEFIK_CONTAINER_NAME:-traefik}
    restart: ${TRAEFIK_RESTART:-unless-stopped}
    mem_limit: ${TRAEFIK_MEM_LIMIT:-100m}
    networks:
      - traefik
    ports:
      - 80:80
      - 443:443
    environment:
      - CF_API_EMAIL={{ CF_API_EMAIL }}
      - CF_DNS_API_TOKEN={{ CF_DNS_API_TOKEN }}
    volumes:
      - /apps/traefik/letsencrypt:/letsencrypt
      - /apps/traefik/data:/data
      - /etc/localtime:/etc/localtime:ro
      - /usr/share/zoneinfo:/usr/share/zoneinfo:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
    command:
      - --api
      - --api.insecure=${TRAEFIK_API_INSECURE:-true}
      - --api.dashboard=true
      - --log.level=ERROR
      - --accesslog=true
      - --entryPoints.metrics.address=:8082
      - --metrics.prometheus.entryPoint=metrics
      - --providers.docker
      - --providers.file.watch=true
      - --providers.file.directory=/data
      - --entrypoints.web.address=:80
      - --entrypoints.websecure.address=:443
      - --entrypoints.web.http.redirections.entrypoint.to=websecure
      - --entrypoints.web.http.redirections.entrypoint.scheme=https
      - --entrypoints.websecure.http.tls=true
      - --entrypoints.websecure.http.tls.certResolver=letsencrypt
      - --entrypoints.websecure.http.tls.domains[0].main={{ TRAEFIK_HOST_DOMAIN }}
      - --entrypoints.websecure.http.tls.domains[0].sans=*.{{ TRAEFIK_HOST_DOMAIN }}
      - --entrypoints.websecure.http.tls.domains[1].main={{ APP0_HOST_DOMAIN }}
      - --entrypoints.websecure.http.tls.domains[1].sans=*.{{ APP0_HOST_DOMAIN }}
      - --serverstransport.insecureskipverify=true
      - --certificatesresolvers.letsencrypt.acme.dnschallenge=true
      - --certificatesresolvers.letsencrypt.acme.dnschallenge.provider=${DNS_CHALLENGE_PROVIDER:-cloudflare}
      - --certificatesresolvers.letsencrypt.acme.email={{ CF_API_EMAIL }}
      - --certificatesresolvers.letsencrypt.acme.storage=/letsencrypt/acme.json
      - --certificatesResolvers.letsencrypt.acme.dnsChallenge.delayBeforeCheck=120
      - --certificatesresolvers.letsencrypt.acme.dnschallenge.resolvers=1.1.1.1:53,1.0.0.1:53
      - --certificatesresolvers.letsencrypt.acme.caserver=https://acme-v02.api.letsencrypt.org/directory
    labels:
      - joyride.host.name=dns02.{{ TRAEFIK_HOST_DOMAIN }}
      - traefik.enable=true
      - traefik.docker.network=traefik
      - traefik.http.routers.traefik.entrypoints=websecure
      # - traefik.http.routers.traefik.rule=Host(`dns02.{{ TRAEFIK_HOST_DOMAIN }}`) && (PathPrefix(`/traefik`) || PathPrefix(`/api`))
      - traefik.http.routers.traefik.rule=Host(`dns02.{{ TRAEFIK_HOST_DOMAIN }}`)
      - traefik.http.routers.traefik.service=api@internal
      # - traefik.http.routers.traefik.middlewares=traefik_strip
      # - traefik.http.middlewares.traefik_strip.stripprefix.prefixes=/traefik

  loki:
    container_name: loki
    image: docker.io/grafana/loki:3.6.3@sha256:cd6e176883a90c21755f0315688668991634143423f75bdedfef41441b0fdc3c
    command: "-config.file=/etc/loki/config.yaml"
    networks:
      - grafana_net
      - traefik
    volumes:
      - /apps/grafana-stack/loki/config.yaml:/etc/loki/config.yaml:ro
      - /mnt/logdata/logs:/loki:rw
    restart: unless-stopped
    labels:
      - traefik.enable=true
      - traefik.http.routers.loki.entrypoints=websecure
      - traefik.http.routers.loki.rule=Host(`loki.{{ TRAEFIK_HOST_DOMAIN }}`)
      - traefik.http.routers.loki.tls=true
      - traefik.http.middlewares.loki=default-headers@file
      - traefik.http.middlewares.loki=https-redirectscheme@file
      - traefik.http.routers.loki.middlewares=default-headers@file
      - traefik.http.services.loki.loadbalancer.server.port=3100
      - traefik.http.routers.loki.service=loki
      - traefik.docker.network=traefik
  grafana:
    image: docker.io/grafana/grafana-oss:12.3.1@sha256:adaf2d6b44c7e2b711b931b98be153778d313806582a24eab21178804fac2976
    container_name: grafana
    networks:
      - traefik
      - grafana_net
    ports:
      - "3000:3000"
    volumes:
      - /apps/grafana-stack/grafana-data:/var/lib/grafana
    environment:
      - GF_SERVER_ROOT_URL={{ grafana_root_url }}
      - GF_SMTP_ENABLED=true
      - GF_SMTP_HOST={{ SMTP_SERVER_ADDRESS }}:{{ SMTP_PORT }}
      - GF_SMTP_USER={{ SMTP_USERNAME }}
      - GF_SMTP_PASSWORD={{ SMTP_PASSWORD }}
      - GF_SMTP_FROM_ADDRESS={{ SMTP_FROM }}
      - GF_SMTP_FROM_NAME=Grafana Notifications
    restart: unless-stopped
    labels:
      - traefik.enable=true
      - traefik.http.routers.grafana.entrypoints=websecure
      - traefik.http.routers.grafana.rule=Host(`grafana.{{ TRAEFIK_HOST_DOMAIN }}`)
      - traefik.http.routers.grafana.tls=true
      - traefik.http.middlewares.grafana=default-headers@file
      - traefik.http.middlewares.grafana=https-redirectscheme@file
      - traefik.http.routers.grafana.middlewares=default-headers@file
      - traefik.http.services.grafana.loadbalancer.server.port=3000
      - traefik.http.routers.grafana.service=grafana
      - traefik.docker.network=traefik
  grafana-mcp:
    image: grafana/mcp-grafana:2.0.2-alpine@sha256:2588c4d5a9fd5e274f9633acfbf2e7076484d10e042faf0f0e2838b7fc973d0a
    container_name: mcp-grafana
    restart: unless-stopped
    networks:
      - traefik
      - grafana_net
    environment:
      - GRAFANA_URL=http://grafana:3000
      - GRAFANA_MCP_SERVER_NAME=grafana-mcp.lan.bladewdr.xyz
      - GRAFANA_SERVICE_ACCOUNT_TOKEN={{ grafana_mcp_server_token }}
      - MCP_GRAFANA_SERVER_TOKEN={{ grafana_mcp_server_token }}
    command:
      - --transport=streamable-http
      - --address=0.0.0.0:8000
      - --allowed-hosts=grafana-mcp.{{ TRAEFIK_HOST_DOMAIN }}
    labels:
      - traefik.enable=true
      - traefik.http.routers.grafana-mcp.entrypoints=websecure
      - traefik.http.routers.grafana-mcp.rule=Host(`grafana-mcp.{{ TRAEFIK_HOST_DOMAIN }}`)
      - traefik.http.routers.grafana-mcp.tls=true
      - traefik.http.middlewares.grafana-mcp=default-headers@file
      - traefik.http.middlewares.grafana-mcp=https-redirectscheme@file
      - traefik.http.routers.grafana-mcp.middlewares=default-headers@file
      - traefik.http.services.grafana-mcp.loadbalancer.server.port=8000
      - traefik.http.routers.grafana-mcp.service=grafana-mcp
      - traefik.docker.network=traefik
  prometheus:
    image: prom/prometheus:v3.8.1@sha256:2b6f734e372c1b4717008f7d0a0152316aedd4d13ae17ef1e3268dbfaf68041b
    container_name: prometheus
    restart: unless-stopped
    extra_hosts:
      - "host.docker.internal:host-gateway"
    user: "1000:1000"
    networks:
      - grafana_net
      - traefik
    environment:
      - TZ={{ host_timezone }}
    security_opt:
      - no-new-privileges:true
    volumes:
      - /apps/grafana-stack/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - /apps/grafana-stack/prometheus/rules.yml:/etc/prometheus/rules.yml:ro
      - /mnt/logdata/prometheus_data:/prometheus
    labels:
      - traefik.enable=true
      - traefik.http.routers.prometheus.entrypoints=websecure
      - traefik.http.routers.prometheus.rule=Host(`prometheus.{{ TRAEFIK_HOST_DOMAIN }}`)
      - traefik.http.routers.prometheus.tls=true
      - traefik.http.middlewares.prometheus=default-headers@file
      - traefik.http.middlewares.prometheus=https-redirectscheme@file
      - traefik.http.routers.prometheus.middlewares=default-headers@file
      - traefik.http.services.prometheus.loadbalancer.server.port=9090
      - traefik.http.routers.prometheus.service=prometheus
      - traefik.docker.network=traefik
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time=30d
      - --web.enable-lifecycle
      - --web.enable-admin-api
      - --web.enable-remote-write-receiver
  alertmanager:
    container_name: alertmanager
    networks:
      - grafana_net
    ports:
      - 9093:9093
    image: quay.io/prometheus/alertmanager
    volumes:
      - /apps/grafana-stack/alertmanager/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
